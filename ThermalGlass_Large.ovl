; Thermal Glass - standalone RTSS OverlayEditor layout, English UI.
; 59 external sensors: 28 WireView, 10 extra GPU temperatures, 21 system readings.
; Reads MSI Afterburner shared memory only. No hardware access or configuration writes.
; Glass tint: alpha 0x26 (~15%). Text stays opaque. No background image or blur shader.
; RAM PROCESS is below CPU USAGE; RAM USAGE is the separate total system reading.
; Native RTSS API/FPS/frametime and autoscaled per-application history graphs.
[Master]
Implementation=2
FontFace=Bahnschrift
FontHeight=-16
FontWeight=400
ZoomRatio=1

[Settings]
Name=Thermal Glass - Large
EnvVars=
RefreshPeriod=1000
LockUserSettings=1
EmbeddedImage=
PingAddr=

[General]
Sources=59
Tables=0
Layers=161

